shebang := if os() == 'windows' { 'pwsh.exe' } else { '/usr/bin/env pwsh' }
set shell := ["pwsh", "-c"]
set windows-shell := ["pwsh.exe", "-NoLogo", "-Command"]
set dotenv-load := true
set script-interpreter := ["pwsh.exe", "-NoLogo", "-Command"]
set dotenv-filename	:= ".env"
set unstable
set fallback
set lists

help:
    @just --list -f "{{home_directory()}}/justfile"

default_arg := 'TODO:'
todo todo=default_arg:
    @rg {{todo}} -g '!justfile' -g "!third_party" 

hello:
    @Write-Host "Hello, world!" -ForegroundColor Yellow

alias b := build
[no-cd]
build:
    npm install && npm run build
    
alias r := run
default_args := ''
[no-cd]
run args=default_args:
    npm run {{args}}

